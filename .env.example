# Web Server Port
PORT=3000

# Serial Port Configuration
# Set AUTO_DETECT=true to automatically find and connect to your ESP32 on cable insert
AUTO_DETECT=true
# Default fallback port if AUTO_DETECT is false (e.g., COM7 on Windows, /dev/ttyUSB0 on Linux/macOS)
SERIAL_PORT=COM7
BAUD_RATE=115200

# Auto-reconnect retry delay in milliseconds
RECONNECT_INTERVAL_MS=3000

# Trail history depth (number of GPS fixes kept in memory and sent to newly connected clients)
MAX_TRAIL_POINTS=500

# Folder where session CSV tracks are saved
LOG_DIR=logs

# Set to true to test the dashboard with simulated GPS motion without physical hardware
SIMULATION_MODE=false
